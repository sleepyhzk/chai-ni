# Sao chép file này thành .env.local rồi điền giá trị từ Supabase (Project Settings -> API).
# Khi để trống, web vẫn chạy bình thường nhưng chỉ lưu tiến độ trên máy (không có đăng nhập).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Dùng anon key hoặc publishable key (sb_publishable_...). KHÔNG dùng service_role / secret key.
VITE_SUPABASE_ANON_KEY=
